# Copie este archivo como .env y complete los valores (el .env no se sube a git).
SPRING_PROFILES_ACTIVE=prod
# Se acepta la "Internal Database URL" de Render (postgresql://...) o una URL JDBC (jdbc:postgresql://...)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE
DATABASE_USERNAME=USUARIO
DATABASE_PASSWORD=CLAVE
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:4200
APP_SEED_ENABLED=false
