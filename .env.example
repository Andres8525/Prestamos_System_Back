# Copie este archivo como .env y complete los valores (el .env no se sube a git).
SPRING_PROFILES_ACTIVE=prod
# Se acepta la "Internal Database URL" de Render (postgresql://...) o una URL JDBC (jdbc:postgresql://...)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE
DATABASE_USERNAME=USUARIO
DATABASE_PASSWORD=CLAVE
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:4200
APP_SEED_ENABLED=false

# --- Disponibilidad (keep-alive) ---
# En Render no hace falta: usa RENDER_EXTERNAL_URL automáticamente. En otro hosting, ponga la URL pública.
# KEEPALIVE_URL=https://mi-backend.ejemplo.com
KEEPALIVE_ENABLED=true

# --- Workers (cola de tareas en segundo plano) ---
WORKERS_THREADS=2

# --- gRPC ---
GRPC_ENABLED=true
GRPC_PORT=9090

# --- Groq (asistente de IA generativa) ---
# Cree la clave en https://console.groq.com/keys. Solo va en el backend, nunca en el frontend.
# Sin clave, el asistente funciona en modo local (sin modelo de lenguaje).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RATE_LIMIT=10
